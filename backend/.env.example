APP_ENV=development
APP_PORT=3000
DATABASE_PATH=./lms.db
# Vercel'de başlangıç veritabanı için isteğe bağlı yol. DATABASE_PATH /tmp/lms.db olur.
DATABASE_SEED_PATH=./lms.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=24h
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT=300
CACHE_SIZE=1000
CACHE_TTL=5m
# Auth session lookups are cached briefly to avoid a DB read on every request
SESSION_CACHE_SIZE=1000
SESSION_CACHE_TTL=30s
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
# Yerel: Python servisi (tanımsızsa APP_ENV=production değilken varsayılan bu adrestir). Vercel'de bu satırı KOPYALAMA/BOŞ BIRAK: tanımsızsa aynı dağıtımın
# adresi kullanılır (vercel.json /api/analyze/* ve /api/health isteklerini Python function'ına yollar).
PERFORMANCE_SERVICE_URL=http://127.0.0.1:8000
# Opsiyonel: Python servisindeki PERFORMANCE_INTERNAL_TOKEN ile aynı değer. Herkese açık analiz
# uç noktalarını (ücretsiz kotayı) korur; Vercel'de proje ortam değişkenlerine bir kez tanımla (Go ve Python function'ları aynı projede).
# PERFORMANCE_INTERNAL_TOKEN=
# Opsiyonel: Vercel Deployment Protection açıksa servis çağrısı için bypass anahtarı
# (VERCEL_AUTOMATION_BYPASS_SECRET Vercel'de varsa otomatik okunur).
# PERFORMANCE_BYPASS_SECRET=
# Varsayılan: yerelde 15s, Vercel'de 8s (function süre sınırına sığmak için).
PERFORMANCE_TIMEOUT=15s
PERFORMANCE_CACHE_SIZE=500
PERFORMANCE_CACHE_TTL=5m
PERFORMANCE_RATE_LIMIT=30

# Cloudflare R2 (video storage). Leave empty to disable direct uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: custom S3-compatible endpoint (defaults to https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# Optional: public bucket/custom domain used for playback; private buckets use presigned GET
R2_PUBLIC_URL=
